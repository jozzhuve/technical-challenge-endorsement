{
  "name": "technical-challenge-endorsement",
  "version": "1.0.0",
  "private": true,
  "description": "Servicio traductor de endosos basado en plantillas dinámicas.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "quality": "npm run lint && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@hapi/hapi": "^21.3.12",
    "joi": "^17.13.3",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@types/hapi__hapi": "^21.0.14",
    "@types/node": "^22.15.21",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitest/coverage-v8": "^3.1.4",
    "eslint": "^8.57.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=22"
  }
}
